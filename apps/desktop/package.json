{
  "name": "@atlas/desktop",
  "version": "0.7.0",
  "private": true,
  "description": "Atlas Forge desktop shell — offline fantasy map generator",
  "author": "Umamed <dev@umamed.example>",
  "homepage": "https://github.com/Umamed26/atlas-forge",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --packaged",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100"
  },
  "devDependencies": {
    "@atlas/core": "workspace:*",
    "@atlas/render": "workspace:*",
    "electron": "44.4.5",
    "electron-builder": "^26.0.0",
    "esbuild": "0.25.12",
    "typescript": "^5.7.0"
  }
}
